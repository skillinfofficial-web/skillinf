{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillinf-cron",
  "main": "cf-cron-worker.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "keep_vars": true,

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },

  // ── Cron triggers (UTC times → IST = UTC+5:30):
  //   "30 2 * * *" = 08:00 IST daily  → due-reminder emails
  //   "30 3 * * *" = 09:00 IST daily  → cert-unlock-notify emails
  "triggers": {
    "crons": ["30 2 * * *", "30 3 * * *"]
  },

  // Direct Worker-to-Worker binding to the main `skillinf` Worker:
  // avoids public DNS redirects (skillinf.in → www.skillinf.in) and WAF checks.
  "services": [
    {
      "binding": "SKILLINF_APP",
      "service": "skillinf"
    }
  ],

  "vars": {
    "FRONTEND_ORIGIN": "https://www.skillinf.in"
  }
  // Required secrets (add via Cloudflare Dashboard on BOTH `skillinf` and `skillinf-cron`):
  //   CRON_SECRET = skillinf_cron_2026_secret_key
}
