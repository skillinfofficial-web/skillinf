{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillinf-cron",
  "main": "cf-cron-worker.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,

  // ── Cron triggers (UTC times → IST = UTC+5:30):
  //   "30 2 * * *" = 08:00 IST daily  → due-reminder emails
  //   "30 3 * * *" = 09:00 IST daily  → cert-unlock-notify emails
  "triggers": {
    "crons": ["30 2 * * *", "30 3 * * *"]
  },

  "vars": {
    "FRONTEND_ORIGIN": "https://skillinf.in"
  }
  // Required secrets (add via Cloudflare Dashboard):
  //   CRON_SECRET = skillinf_cron_2026_secret_key
}
