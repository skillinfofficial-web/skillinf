{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillinf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  },
  "vars": {
    "CASHFREE_APP_ID": "14095521255f4a5112a7d862ae02559041",
    "CASHFREE_ENV": "production",
    "NEXT_PUBLIC_CASHFREE_ENV": "production",
    "MONGODB_DATABASE": "skillinf_course_data",
    "NEXT_PUBLIC_BASE_URL": "https://skillinf-backend.onrender.com"
  }
}
